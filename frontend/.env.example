# URL base de la API (sin barra final). Vite solo expone variables con prefijo VITE_
# y las fija en tiempo de build: cambiarla requiere volver a ejecutar `npm run build`.
# Desarrollo (backend local con `bin/rails server`):
VITE_API_URL=http://localhost:3000/api/v1
# Produccion (la fija el pipeline de Jenkins al construir la imagen Docker):
# VITE_API_URL=https://apibalancefood.frubilarz.cl/api/v1
